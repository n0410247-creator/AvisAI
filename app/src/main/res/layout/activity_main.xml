<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/avis_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AVIS AI"
            android:textColor="@color/avis_blue"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="YOUR PERSONAL ASSISTANT"
        android:textColor="@color/avis_text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Chat bubble -->
    <LinearLayout
        android:id="@+id/chatBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/avisGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hey Boss! I'm Avis."
            android:textColor="@color/avis_blue"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/avisSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="How can I assist you today?"
            android:textColor="@color/avis_text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Center circle -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/avis_ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVIS"
                android:textColor="@color/avis_text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE"
                android:textColor="@color/avis_cyan"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/listeningLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="TAP THE MIC TO SPEAK"
        android:textColor="@color/avis_cyan"
        android:textSize="12sp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="20dp" />

    <!-- Mic + keyboard row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/keyboardButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="30dp"
            android:background="@drawable/panel_bg"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Type instead" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/mic_bg"
            android:src="@android:drawable/ic_btn_speak_now"
            android:contentDescription="Speak to Avis" />

        <ImageButton
            android:id="@+id/cameraButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="30dp"
            android:background="@drawable/panel_bg"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Camera" />
    </LinearLayout>

</LinearLayout>
